# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# large files
java_pid*.hprof

# Build output dirs
build/
android-app/build/
android-app/app/build/
android-app/.gradle/
android-app/.idea/

# Android Studio project state actually lives at the repo root (opened with
# the repo itself as the project, not android-app/) — the rules above never
# matched it, so it sat tracked in history until 2026-08-26.
/.gradle/
/.idea/
/local.properties

# Python
__pycache__/
*.pyc
*.pyo
.venv/
pc-app/.venv/

# PC app recordings (local test captures)
pc-app/recordings/vega_*.csv

# Raw oscilloscope waveform captures (large; settings .txt files still tracked)
pc-app/analysis/scope/*.csv

# Bench/soak data — research data, slated for a private research repo per
# PLAN.md B.1 ("Move research data out"), not vega history.
pc-app/bench/*.csv
pc-app/stall_log_*.txt
